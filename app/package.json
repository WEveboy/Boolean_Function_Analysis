{
  "name": "boolean-function-lab",
  "version": "2.1.0",
  "private": true,
  "description": "单输出与多输出布尔函数安全性指标分析",
  "author": "Boolean Function Lab",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build",
    "dist:win": "pnpm build:web && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "cn.booleanfunction.lab",
    "productName": "布尔函数安全性分析",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "../dist" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [
      { "from": "../cpp/build/bf-core.exe", "to": "bin/bf-core.exe" },
      { "from": "../multi-output/cpp/build/vbf-core.exe", "to": "bin/vbf-core.exe" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "BooleanFunctionLab-${version}-portable.exe"
    },
    "portable": { "artifactName": "BooleanFunctionLab-${version}-portable.exe" }
  }
}
