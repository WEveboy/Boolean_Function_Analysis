{
  "name": "vectorial-boolean-function-lab",
  "version": "1.0.1",
  "private": true,
  "description": "多输出布尔函数与 S 盒安全性指标分析",
  "author": "Vectorial Boolean Function Lab",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "build:web": "vite build",
    "dist:win": "pnpm build:web && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "cn.vectorialboolean.lab",
    "productName": "多输出布尔函数安全性分析",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "../dist" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [
      { "from": "../cpp/build/vbf-core.exe", "to": "bin/vbf-core.exe" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "VectorialBooleanLab-${version}-portable.exe"
    },
    "portable": { "artifactName": "VectorialBooleanLab-${version}-portable.exe" }
  }
}
